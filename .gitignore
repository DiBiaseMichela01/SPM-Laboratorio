# Ignore .NET build outputs (generated during compilation)
**/bin/
**/obj/

# Ignore Visual Studio user-specific settings
.vs/
**/*.user
**/*.suo

# Ignore IntelliJ IDEA configuration files
.idea/

# Ignore React dependencies and generated build files
**/node_modules/
**/dist/
**/build/

# Ignore local configuration files containing sensitive data
**/appsettings.Development.json
.env
.env.*

# Ignore local SQLite databases
*.db
*.db-shm
*.db-wal