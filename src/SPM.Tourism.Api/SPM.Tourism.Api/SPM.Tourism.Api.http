### TEST 1 - Successful registration (Expected: 200 OK)
POST https://localhost:7067/api/Auth/register
Content-Type: application/json

{
  "email": "registration.success02@example.com",
  "password": "Giulia123!",
  "confirmPassword": "Giulia123!"
}

### TEST 2 - Duplicate email (Expected: 409 Conflict)
POST https://localhost:7067/api/Auth/register
Content-Type: application/json

{
  "email": "giulia@example.com",
  "password": "Giulia123!",
  "confirmPassword": "Giulia123!"
}

### TEST 3 - Invalid email format (Expected: 400 Bad Request)
POST https://localhost:7067/api/Auth/register
Content-Type: application/json

{
  "email": "giuliaexample.com",
  "password": "Giulia123!",
  "confirmPassword": "Giulia123!"
}

### TEST 4 - Password confirmation mismatch (Expected: 400 Bad Request)
POST https://localhost:7067/api/Auth/register
Content-Type: application/json

{
  "email": "test.password@example.com",
  "password": "Giulia123!",
  "confirmPassword": "Diversa123!"
}
### TEST 5 - Successful login (Expected: 200 OK)
POST https://localhost:7067/api/Auth/login
Content-Type: application/json

{
  "email": "registration.success02@example.com",
  "password": "Giulia123!"
}
### TEST 6 - Invalid password (Expected: 401 Unauthorized)
POST https://localhost:7067/api/Auth/login
Content-Type: application/json

{
  "email": "registration.success02@example.com",
  "password": "PasswordSbagliata123!"
}
### TEST 7 - Unregistered email (Expected: 401 Unauthorized)
POST https://localhost:7067/api/Auth/login
Content-Type: application/json

{
  "email": "unknown.user999@example.com",
  "password": "Giulia123!"
}
### TEST 8 - Invalid email format (Expected: 400 Bad Request)
POST https://localhost:7067/api/Auth/login
Content-Type: application/json

{
  "email": "invalid-email",
  "password": "Giulia123!"
}
### TEST 9 - Protected endpoint without token (Expected: 401 Unauthorized)
GET https://localhost:7067/api/Auth/me